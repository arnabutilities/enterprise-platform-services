# Host Shell environment variables (Vite)
# Copy to .env.local and adjust as needed. Never commit real secrets.

NODE_ENV=development

# Backend-for-frontend base URL
VITE_BFF_URL=http://localhost:4000

# Remote MFE URLs (used by src/config/mfeRegistry.ts)
VITE_ANALYTICS_URL=http://localhost:5001
VITE_REPORTS_URL=http://localhost:5002
VITE_LOGIN_URL=http://localhost:5003

# Allowed postMessage origins for cross-MFE auth communication
VITE_ALLOWED_MESSAGE_ORIGINS=http://localhost:5003
