{
  "name": "bff",
  "private": true,
  "version": "1.0.0",
  "description": "Enterprise Backend for Frontend (BFF) with NestJS, TypeScript, PKCE Auth & GraphQL",
  "author": "Enterprise Architecture Team",
  "license": "MIT",
  "scripts": {
    "start": "nest start",
    "prestart:dev": "pnpm --filter @enterprise-platform/observability --filter @enterprise-platform/security run build",
    "start:dev": "nest start --watch",
    "dev:bff:docker": "docker compose -f ../../infra/docker/docker-compose.yml -f ../../infra/docker/docker-compose.bff.yml up --build -d",
    "dev:docker": "docker compose -f ../../infra/docker/docker-compose.yml up --build -d",
    "predev": "pnpm --filter @enterprise-platform/observability --filter @enterprise-platform/security run build",
    "dev": "nest start",
    "dev:bff:docker:down": "docker compose -f ../../infra/docker/docker-compose.yml -f ../../infra/docker/docker-compose.bff.yml down",
    "dev:docker:down": "docker compose -f ../../infra/docker/docker-compose.yml down",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prebuild": "pnpm --filter @enterprise-platform/observability --filter @enterprise-platform/security run build",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint \"{src,tests}/**/*.ts\" --fix",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./tests/jest-e2e.json"
  },
  "dependencies": {
    "@enterprise-platform/contracts": "workspace:*",
    "@enterprise-platform/observability": "workspace:*",
    "@enterprise-platform/security": "workspace:*",
    "@nestjs/apollo": "^12.0.0",
    "@nestjs/axios": "^3.0.0",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/graphql": "^12.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.0.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/typeorm": "^9.0.0",
    "@nestjs/websockets": "^10.0.0",
    "@apollo/server": "^5.5.1",
    "axios": "^1.6.0",
    "cache-manager": "^6.4.0",
    "@keyv/redis": "^4.2.0",
    "keyv": "^5.2.0",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.1.0",
    "graphql": "^16.8.0",
    "graphql-subscriptions": "^2.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.0",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.0",
    "socket.io": "^4.7.0",
    "typeorm": "^0.3.17",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.22",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^3.0.11",
    "@types/cookie-parser": "^1.4.10",
    "@types/supertest": "^7.1.3",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^10.4.0",
    "jest": "^29.5.0",
    "prettier": "^3.1.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.0"
  }
}
